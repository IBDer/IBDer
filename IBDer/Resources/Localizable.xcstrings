      "comment": "Recording entry point: toilet event.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如厕"
          }
        }
      }
    },
    "entry.meal": {
      "comment": "Recording entry point: meal (including oral nutritional supplement).",
