            "state": "translated",
            "value": "记录内核开发中"
          }
        }
      }
    },
    "today.section.events": {
      "comment": "Section header above the day's recorded facts.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日记录"
          }
        }
      }
    },
    "today.empty.title": {
      "comment": "Empty day heading.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还没有记录"
          }
        }
      }
    },
    "today.empty.body": {
      "comment": "Empty day: names the next action.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从下面记一次，或者完成今天的确认"
          }
        }
      }
    },
    "today.previousDay": {
      "comment": "Accessibility label for the previous-day arrow.",
