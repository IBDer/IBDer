        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前一天"
          }
        }
      }
    },
    "today.nextDay": {
      "comment": "Accessibility label for the next-day arrow.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后一天"
          }
        }
      }
    },
