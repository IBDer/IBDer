        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "饮食"
          }
        }
      }
    },
    "entry.medication": {
      "comment": "Recording entry point: medication actually taken.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用药"
          }
        }
