    "biologic.regimen.adalimumab": {
      "comment": "The label's text.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "皮下 160 mg、第 15 天 80 mg；第 29 天起 40 mg 隔周"
          }
        }
      }
    },
    "biologic.regimen.guselkumab": {
      "comment": "The label's text.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静脉 200 mg，第 0、4、8 周；第 16 周起 100 mg 皮下，每 8 周"
          }
        }
      }
    },
    "biologic.regimen.infliximab": {
      "comment": "The label's text, shown as the label's text.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静脉 5 mg/kg，第 0、2、6 周；之后每 8 周"
          }
        }
      }
    },
    "biologic.regimen.risankizumab": {
      "comment": "The label's text.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静脉 600 mg，第 0、4、8 周；第 12 周起 180 mg 皮下，每 8 周"
          }
        }
      }
    },
    "biologic.regimen.ustekinumab": {
      "comment": "The label's text.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静脉按体重一次（≤55 kg 260 mg，≤85 kg 390 mg，>85 kg 520 mg）；第 8 周起 90 mg 皮下，每 12 周"
          }
        }
      }
    },
    "biologic.regimen.vedolizumab": {
      "comment": "The label's text.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静脉 300 mg，第 0、2、6 周；之后每 8 周"
          }
        }
      }
    },
